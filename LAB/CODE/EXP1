        "# FIND-S Algorithm with Graph\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Training dataset\n",
        "data = [\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']\n",
        "]\n",
        "\n",
        "attributes = ['Sky', 'AirTemp', 'Humidity', 'Wind', 'Water', 'Forecast']\n",
        "\n",
        "# Initialize hypothesis\n",
        "hypothesis = None\n",
        "history = []\n",
        "steps = []\n",
        "\n",
        "print(\"FIND-S Algorithm\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "# Apply FIND-S with correct indentation\n",
        "for i, row in enumerate(data, start=1):\n",
        "    x = row[:-1]\n",
        "    target = row[-1]\n",
        "\n",
        "    if target == 'Yes':\n",
        "        if hypothesis is None:\n",
        "            hypothesis = x.copy()\n",
        "        else:\n",
        "            for j in range(len(hypothesis)):\n",
        "                if hypothesis[j] != x[j]:\n",
        "                    hypothesis[j] = '?'\n",
        "\n",
        "    if hypothesis is None:\n",
        "        current = ['Ø'] * len(attributes)\n",
        "    else:\n",
        "        current = hypothesis.copy()\n",
        "\n",
        "    history.append(current)\n",
        "    steps.append(sum(v == '?' for v in current))\n",
        "\n",
        "    print(f\"Example {i}: {target}\")\n",
        "    print(\"Hypothesis:\", current)\n",
        "\n",
        "print(\"-\" * 50)\n",
        "print(\"Final Most Specific Hypothesis:\")\n",
        "print(hypothesis)\n",
        "\n",
        "# Graph: hypothesis generalization over examples\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(range(1, len(data) + 1), steps, marker='o', linewidth=2, color='blue')\n",
        "\n",
        "plt.xticks(range(1, len(data) + 1))\n",
        "plt.xlabel(\"Training Example\")\n",
        "plt.ylabel(\"Number of Generalized Attributes (?)\")\n",
        "plt.title(\"FIND-S Algorithm - Hypothesis Generalization\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\"\"\"FIND-S Algorithm\n",
        "--------------------------------------------------\n",
        "Example 1: Yes\n",
        "Hypothesis: ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same']\n",
        "\n",
        "Example 2: Yes\n",
        "Hypothesis: ['Sunny', 'Warm', '?', 'Strong', 'Warm', 'Same']\n",
        "\n",
